# Copy to .env.local and fill values

# LLM
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-2024-08-06
OPENAI_API_KEY=

# Image generation
FAL_KEY=
FAL_IMAGE_MODEL=fal-ai/flux/schnell

# TTS / STT
GRADIUM_API_KEY=
GRADIUM_TTS_PADDING_BONUS=-1.2

# Storage (optional — falls back to in-memory)
DATABASE_URL=

# Logging (optional)
LOG_LEVEL=
